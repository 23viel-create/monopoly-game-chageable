# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=monopoly
DB_PASSWORD=
DB_PORT=5432

# Server
PORT=5000

# JWT (required in production). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Cloudinary image uploads (Cloudinary dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: top-level folder for uploads (default: monopoly)
CLOUDINARY_FOLDER=monopoly
